# Dossier privé à conserver entre les redémarrages et déploiements.
DATA_DIR=./data
# Adresse publique du site, indispensable avant d'activer LinkedIn.
SITE_URL=https://nestate.site
# En production seulement : origine publique exacte pour les formulaires.
# ORIGIN=https://nestate.site
# Facultatif : clé base64 de 32 octets. Sinon data/.encryption-key est créée.
# Conserver cette clé avec les sauvegardes de la base de données.
# DATA_ENCRYPTION_KEY=
# Limite HTTP (52 Mo par défaut via npm start ; images limitées à 50 Mo).
# BODY_SIZE_LIMIT=52M
# Référencement : activé par défaut uniquement sur Railway production.
# Recette et les autres environnements Railway restent toujours en noindex.
# INDEXING_ENABLED=false
